<Window x:Class="WPF_Episode14_TabControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPF_Episode14_TabControl"
        mc:Ignorable="d"
        Title="WPF Episode 14: TabControl Demo" Height="650" Width="1100">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Navigation Panel -->
        <Border Grid.Column="0" Background="#2C3E50" Padding="10">
            <StackPanel>
                <TextBlock Text="TabControl Demos" 
                           FontSize="16" FontWeight="Bold" 
                           Foreground="White" Margin="0,0,0,20"/>
                
                <Button Content="1. Basic TabControl" Click="ShowBasicTabControl" 
                        Margin="0,5" Padding="10,5"/>
                <Button Content="2. Custom Headers" Click="ShowCustomHeaders" 
                        Margin="0,5" Padding="10,5"/>
                <Button Content="3. Tab Positions" Click="ShowTabPositions" 
                        Margin="0,5" Padding="10,5"/>
                <Button Content="4. Settings Panel" Click="ShowSettingsPanel" 
                        Margin="0,5" Padding="10,5"/>
                <Button Content="5. Document Editor" Click="ShowDocumentEditor" 
                        Margin="0,5" Padding="10,5"/>
                <Button Content="6. Wizard Form" Click="ShowWizardForm" 
                        Margin="0,5" Padding="10,5"/>
                <Button Content="7. Dashboard" Click="ShowDashboard" 
                        Margin="0,5" Padding="10,5"/>
                <Button Content="8. Styled TabControl" Click="ShowStyledTabControl" 
                        Margin="0,5" Padding="10,5"/>
                <Button Content="9. Advanced" Click="ShowAdvanced" 
                        Margin="0,5" Padding="10,5"/>
            </StackPanel>
        </Border>
        
        <!-- Content Panel -->
        <ScrollViewer Grid.Column="1" x:Name="ContentPanel" 
                      VerticalScrollBarVisibility="Auto" 
                      Background="#ECF0F1">
            <Border Background="White" Margin="20" Padding="30" 
                    CornerRadius="10">
                <StackPanel>
                    <TextBlock Text="Welcome to TabControl Demo" 
                               FontSize="28" FontWeight="Bold" 
                               Margin="0,0,0,20"/>
                    
                    <TextBlock TextWrapping="Wrap" FontSize="14" Margin="0,10">
                        TabControl organizes content into tabs, allowing users to 
                        switch between multiple pages in the same window space. 
                        Perfect for settings, multi-document interfaces, and wizards!
                    </TextBlock>
                    
                    <TextBlock TextWrapping="Wrap" FontSize="14" Margin="0,10">
                        Click any button on the left to see different TabControl demos!
                    </TextBlock>
                    
                    <Border Background="LightBlue" Padding="15" Margin="0,20" 
                            CornerRadius="5" BorderBrush="Blue" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Key Features:" FontWeight="Bold" 
                                       FontSize="16" Margin="0,0,0,10"/>
                            <TextBlock Text="• Multi-page navigation in one window" Margin="0,5"/>
                            <TextBlock Text="• Custom tab headers with icons" Margin="0,5"/>
                            <TextBlock Text="• Perfect for settings and wizards" Margin="0,5"/>
                            <TextBlock Text="• Flexible tab positioning" Margin="0,5"/>
                            <TextBlock Text="• Professional organization" Margin="0,5"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>